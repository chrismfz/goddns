[Unit]
Description=goddns self-hosted Dynamic DNS (RFC2136/TSIG)
After=network-online.target named.service
Wants=network-online.target

[Service]
Type=simple
User=goddns
Group=goddns
# Allow binding low ports too (harmless on the default :8245):
AmbientCapabilities=CAP_NET_BIND_SERVICE
# Provide the TSIG secret(s) out-of-band (root-only file, optional):
EnvironmentFile=-/etc/goddns/goddns.env
ExecStart=/usr/bin/goddns serve -config /etc/goddns/goddns.conf
# SIGHUP = immediate config re-read (the poll loop also picks changes up)
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/goddns
ReadWritePaths=-/var/log/goddns.log
ReadWritePaths=-/var/log/goddns-access.log
ReadOnlyPaths=-/etc/letsencrypt
ProtectKernelTunables=true
ProtectControlGroups=true
# AF_UNIX is needed to reach the goddns-zoned helper socket (web static editing).
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
