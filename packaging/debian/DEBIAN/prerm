#!/bin/sh
set -e

# stop/disable on remove
if [ "$1" = "remove" ] || [ "$1" = "deconfigure" ]; then
    if command -v systemctl >/dev/null 2>&1; then
        for u in goddns.service goddns-zoned.service; do
            systemctl stop "$u" || true
            systemctl disable "$u" || true
        done
    fi
fi

exit 0
